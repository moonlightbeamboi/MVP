# ── Firebase (OPTIONAL) ────────────────────────────────────────────────────
# Without this file the app runs on an offline local store with identical
# behaviour. To go live-multi-device:
#   1. Create a project at https://console.firebase.google.com
#   2. Build → Firestore Database → Create database (test mode, region closest to you)
#   3. Project settings → Your apps → Web app → copy the config values below
#   4. Copy this file to `.env` and restart `npm run dev`
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
